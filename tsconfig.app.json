{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020"],
    "types": ["react", "react-native"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["App.tsx", "src/app/**/*.tsx", "src/app/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
